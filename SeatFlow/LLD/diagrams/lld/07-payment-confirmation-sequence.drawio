        <mxCell id="m1" value="1. POST /bookings/{id}/confirm {paymentMethodToken}" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="150" as="sourcePoint" />
            <mxPoint x="340" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. guard: status==HELD -&gt; PAYMENT_PENDING
(DB txn, no external call inside)" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;rounded=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="220" as="sourcePoint" />
            <mxPoint x="460" y="220" as="targetPoint" />
            <Array as="points"><mxPoint x="460" y="250"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. initiatePayment(bookingId, amount, idemKey)" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="300" as="sourcePoint" />
            <mxPoint x="620" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. provider charge request" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="360" as="sourcePoint" />
            <mxPoint x="900" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. 202 Accepted (async — provider may redirect for 3DS)" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="420" as="sourcePoint" />
            <mxPoint x="340" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. 202 {status: PAYMENT_PENDING}" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="490" as="sourcePoint" />
            <mxPoint x="100" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. webhook: paymentId SUCCEEDED" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="550" as="sourcePoint" />
            <mxPoint x="1180" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8. idempotent on paymentId;
BEGIN TX: status=CONFIRMED,
items=CONFIRMED, outbox(BookingConfirmed)
COMMIT" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;rounded=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1180" y="610" as="sourcePoint" />
            <mxPoint x="1300" y="610" as="targetPoint" />
            <Array as="points"><mxPoint x="1300" y="640"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. 200 OK" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1180" y="700" as="sourcePoint" />
            <mxPoint x="900" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note0" value="The call to Payment Service (step 3) happens OUTSIDE any DB
transaction — provider latency (seconds to minutes for 3DS)
must never hold a Postgres transaction open. Confirmation only
happens in the callback handler (step 8), in its own short txn." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="770" width="640" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
