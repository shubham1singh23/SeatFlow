        <mxCell id="m1" value="1. findExpired(now): status IN (HELD,FAILED)
AND held_until &lt; now()" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="150" as="sourcePoint" />
            <mxPoint x="500" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. query (index on status, held_until)" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="220" as="sourcePoint" />
            <mxPoint x="900" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. candidate booking rows" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="280" as="sourcePoint" />
            <mxPoint x="500" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. per booking: BEGIN TX
guard status still HELD/FAILED (optimistic version check)
UPDATE status=EXPIRED, items=RELEASED
INSERT outbox(BookingExpired)
COMMIT" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="340" as="sourcePoint" />
            <mxPoint x="900" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. relay publishes BookingExpired" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="440" as="sourcePoint" />
            <mxPoint x="1250" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note0" value="Guard excludes PAYMENT_PENDING by construction (see
03-booking-lifecycle.md) — a booking with payment genuinely in
flight can never be expired out from under the user." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="520" width="700" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Optimistic version check: if a user's ConfirmBooking/CancelBooking
commits first, the worker's UPDATE affects 0 rows and is treated
as a no-op, not an error — whichever transaction commits first wins." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="610" width="700" height="70" as="geometry" />
        </mxCell>
