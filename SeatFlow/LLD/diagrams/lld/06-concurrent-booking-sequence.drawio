            <mxPoint x="1180" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. INSERT succeeds (first to commit)" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1180" y="390" as="sourcePoint" />
            <mxPoint x="620" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. INSERT fails: 23505 unique violation" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1180" y="450" as="sourcePoint" />
            <mxPoint x="900" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. 201 Created — seat A10 held" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="520" as="sourcePoint" />
            <mxPoint x="100" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8. 409 SEAT_UNAVAILABLE" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="580" as="sourcePoint" />
            <mxPoint x="340" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="The race is resolved by PostgreSQL itself at the INSERT into
booking_items: the unique index guarantees exactly one of the
two concurrent inserts can succeed, regardless of which of the
two Booking Service instances issued it, and regardless of timing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="660" width="620" height="90" as="geometry" />
        </mxCell>
      </root>
