        <mxCell id="m4" value="4. INSERT booking_item(showId, seatA10)" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
