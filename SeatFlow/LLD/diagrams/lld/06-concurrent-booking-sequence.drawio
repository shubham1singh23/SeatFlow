            <mxPoint x="900" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. INSERT booking_item(showId, seatA10)" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
