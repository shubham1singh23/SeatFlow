        <mxCell id="m1" value="1. POST /bookings {seatA10}" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1">
