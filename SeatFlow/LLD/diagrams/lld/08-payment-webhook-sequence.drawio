            <mxPoint x="150" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note0" value="Duplicate/at-least-once webhook delivery is expected, not exceptional.
The callback handler's idempotency check on paymentId is what makes
repeated delivery safe — it is not treated as a failure case." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
