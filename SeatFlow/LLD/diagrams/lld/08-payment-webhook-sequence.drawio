        <mxCell id="m8" value="8. 200 OK  (no-op — idempotent, NOT an error,
no second UPDATE, no second outbox row)" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;dashed=1;" edge="1" parent="1">
